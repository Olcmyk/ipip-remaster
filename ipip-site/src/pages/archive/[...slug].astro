---
import MainLayout from '../../layouts/MainLayout.astro';
import archiveCatalog from '../../../public/data/archive-catalog.json';

const catalog = archiveCatalog;

export async function getStaticPaths() {
  const catalog = archiveCatalog;
  const paths = [];

  // Category pages
  for (const category of catalog.categories) {
    paths.push({
      params: { slug: category }
    });
  }

  // Individual document pages
  for (const doc of catalog.allDocuments) {
    paths.push({
      params: { slug: `${doc.category}/${doc.filename}` }
    });
  }

  return paths;
}

const { slug } = Astro.params;

// Check if this is a category page or document page
const isCategory = catalog.categories.includes(slug);

// Prepare data for both cases
let categoryName = '';
let docs = [];
let doc = null;
let archivePath = '';

if (isCategory) {
  // Category page
  docs = catalog.byCategory[slug];
  categoryName = slug.replace(/-/g, ' ');
} else {
  // Document page - extract category and filename
  const parts = slug.split('/');
  const category = parts[0];
  const filename = parts.slice(1).join('/');

  doc = catalog.allDocuments.find(d =>
    d.category === category && d.filename === filename
  );

  if (!doc) {
    return Astro.redirect('/archive');
  }

  archivePath = `/archive/ipip-mirror/ipip.ori.org/${doc.filename}`;
}
---

{isCategory ? (
  <MainLayout title={categoryName}>
    <div class="mb-6">
      <a href="/archive" class="text-blue-600 hover:underline mb-4 inline-block">
        ← Back to Archive
      </a>
      <h1 class="text-3xl font-bold text-gray-900 mb-2 capitalize">{categoryName}</h1>
      <p class="text-gray-600">
        {docs.length} documents in this category
      </p>
    </div>

    <div class="space-y-3">
      {docs.map(doc => (
        <a
          href={`/archive/${doc.category}/${doc.filename}`}
          class="block bg-white rounded-lg shadow-sm border border-gray-200 p-4 hover:shadow-md transition-shadow"
        >
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <h3 class="font-bold text-gray-900 mb-1">{doc.title}</h3>
              <p class="text-sm text-gray-600 mb-2">{doc.description}</p>
              <div class="flex items-center gap-2">
                <span class="text-xs bg-gray-100 text-gray-700 px-2 py-0.5 rounded uppercase">
                  {doc.type}
                </span>
                <span class="text-xs text-gray-500">
                  {(doc.size / 1024).toFixed(1)} KB
                </span>
              </div>
            </div>
            <div class="ml-4 text-gray-400">
              →
            </div>
          </div>
        </a>
      ))}
    </div>
  </MainLayout>
) : (
  <MainLayout title={doc?.title || 'Document'}>
    <div class="mb-6">
      <a href={`/archive/${doc?.category}`} class="text-blue-600 hover:underline mb-4 inline-block">
        ← Back to {doc?.category.replace(/-/g, ' ')}
      </a>
      <div class="flex items-center gap-3 mb-2">
        <h1 class="text-2xl font-bold text-gray-900">{doc?.title}</h1>
        <button
          id="style-toggle-btn"
          class="px-3 py-1.5 text-xs font-medium text-gray-600 bg-gray-100 border border-gray-300 rounded-md hover:bg-gray-200 hover:text-gray-900 transition-colors"
        >
          View Original
        </button>
      </div>
      <p class="text-sm text-gray-600">{doc?.description}</p>
    </div>

    {doc?.type === 'pdf' ? (
      <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
        <div class="text-center">
          <p class="text-gray-700 mb-4">
            This is a PDF document. You can download it or view it in your browser.
          </p>
          <a
            href={archivePath}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700"
          >
            Open PDF
          </a>
        </div>
      </div>
    ) : doc?.type === 'document' ? (
      <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
        <div class="text-center">
          <p class="text-gray-700 mb-4">
            This is a {doc.filename.split('.').pop()?.toUpperCase()} document.
          </p>
          <a
            href={archivePath}
            download
            class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700"
          >
            Download Document
          </a>
        </div>
      </div>
    ) : (
      <div class="bg-white rounded-lg shadow-md border border-gray-200 overflow-hidden">
        <iframe
          src={archivePath}
          class="w-full"
          style="min-height: 800px; border: none;"
          title={doc?.title}
        />
      </div>
    )}

    <div class="mt-6 text-center">
      <a
        href={archivePath}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-blue-600 hover:underline"
      >
        Open in new tab
      </a>
    </div>
  </MainLayout>
)}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('style-toggle-btn');
    const iframe = document.querySelector('iframe');

    if (toggleBtn && iframe) {
      toggleBtn.addEventListener('click', () => {
        try {
          const iframeDoc = iframe.contentDocument || iframe.contentWindow?.document;
          if (iframeDoc) {
            iframeDoc.body.classList.toggle('no-custom-styles');
            toggleBtn.textContent = iframeDoc.body.classList.contains('no-custom-styles')
              ? 'View Styled'
              : 'View Original';
          }
        } catch (e) {
          console.error('Cannot access iframe content:', e);
        }
      });
    }
  });
</script>
