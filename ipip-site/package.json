{
  "name": "ipip-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/post-build-inject-styles.js",
    "preview": "astro preview",
    "astro": "astro",
    "extract:items": "node scripts/parse-items.js",
    "extract:scales": "node scripts/parse-scoring-keys.js",
    "extract:translations": "node scripts/parse-translations.js",
    "extract:archive": "node scripts/catalog-archive.js",
    "extract:all": "npm run extract:items && npm run extract:scales && npm run extract:translations && npm run extract:archive"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.4",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "playwright": "^1.59.1",
    "xlsx": "^0.18.5"
  }
}
